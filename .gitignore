# Whitelist-only: ignore everything, then explicitly allow what is tracked.
# This repo's worktree is $HOME, so anything not listed here must stay untracked.
*

# Repo metadata
!/.gitignore
!/.gitmodules
!/install.sh
!/README.md
!/LICENSE
!/AGENTS.md
!/CLAUDE.md

# ~/.local -- commands, shared helpers and the shtuff framework (submodule).
# Re-include each level; everything else in .local (other tools' data) stays ignored.
!/.local/
/.local/*
!/.local/bin/
!/.local/bin/**
!/.local/share/
/.local/share/*
!/.local/share/dotfiles/
!/.local/share/dotfiles/**
!/.local/share/shtuff

# Shell
!/.profile
!/.bash_profile
!/.bashrc
!/.zprofile
!/.zshrc

# Git
!/.gitconfig

# ~/.config -- allow the directory, then whitelist each app inside it.
# Directories must be re-included at every level before their contents can be.
!/.config/
/.config/*
!/.config/shell/
!/.config/shell/**
# Plugins: the enabled list and each plugin's folder are tracked. plugins.local (per-machine
# overrides) is deliberately not allowed, so it stays untracked.
!/.config/dotfiles/
/.config/dotfiles/*
!/.config/dotfiles/plugins.list
!/.config/dotfiles/plugins/
!/.config/dotfiles/plugins/**

# Example for another app:
# !/.config/nvim/
# !/.config/nvim/**
