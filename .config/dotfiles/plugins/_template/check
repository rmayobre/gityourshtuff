#!/usr/bin/env bash
# check: health check for the installed software. (optional)
#
# RESERVED: dot-doctor does not call plugin hooks yet. This documents the planned contract.
#
# Planned: run by dot-doctor for installed plugins. `installed` answers "is it there?"; this
# answers "does it work?", e.g. `flutter doctor` finds no missing licenses, the right version
# is on PATH, a config file parses. Without this file dot-doctor only reports whether the
# plugin is installed.
#
# Contract
#   Exit 0      healthy. Print nothing, or a short note that dot-doctor shows as information.
#   Exit != 0   unhealthy. Print what is wrong and how to fix it; dot-doctor shows it as a
#               warning.
#   Read-only: don't change anything, and don't download.
#
# Environment
#   DOT_PLUGIN, DOT_PLUGIN_DIR, DOT_OS, DOT_ROOT, DOT_COMMON: as in `init`.
#   DOT_HOOK        "check"
#
# Arguments: none.
